// Voxura AI Calling Agent — data model.
// Every business record belongs to one Workspace (company). Queries must always filter by workspaceId.
// Uniqueness (agent names, catalog names, lead phones) is per workspace, never global.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & users ----------

model Workspace {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(120)
  gstNumber      String?   @db.VarChar(20)
  walletBalance  Decimal   @default(0) @db.Decimal(12, 2)
  lowBalanceAt   Decimal   @default(200) @db.Decimal(12, 2)
  callWindowFrom String    @default("10:00") @db.VarChar(5) // default calling hours (IST) for campaigns
  callWindowTo   String    @default("19:00") @db.VarChar(5)
  planId         String?
  planRenewsOn   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plan         Plan?               @relation(fields: [planId], references: [id])
  users        User[]
  agents       Agent[]
  catalogItems CatalogItem[]
  phoneNumbers PhoneNumber[]
  leads        Lead[]
  campaigns    Campaign[]
  calls        Call[]
  followUps    FollowUp[]
  transactions WalletTransaction[]
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String   @db.VarChar(120)
  email           String   @unique @db.VarChar(190)
  phone           String?  @db.VarChar(20)
  passwordHash    String   @db.VarChar(100)
  role            UserRole @default(OWNER)
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]     @relation("LeadOwner")
  followUps     FollowUp[] @relation("FollowUpOwner")

  @@index([workspaceId])
}

// ---------- Plans (platform-level, shared by all workspaces) ----------

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique @db.VarChar(60)
  monthlyPrice Decimal  @db.Decimal(12, 2)
  agentLimit   Int
  channels     Int
  kbChars      Int
  faqLimit     Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspaces Workspace[]
}

// ---------- Agents ----------

enum AgentMode {
  ASSISTANT
  ANNOUNCEMENT
}

enum CallPurpose {
  OUTBOUND
  INBOUND
  BOTH
}

enum AgentStatus {
  ACTIVE
  PAUSED
}

model Agent {
  id                   String      @id @default(cuid())
  workspaceId          String
  name                 String      @db.VarChar(120)
  status               AgentStatus @default(ACTIVE)
  mode                 AgentMode   @default(ASSISTANT)
  purpose              CallPurpose @default(OUTBOUND)
  phoneNumberId        String?
  // what to say
  greeting             String?     @db.Text
  systemPrompt         String?     @db.Text
  fallbackResponse     String?     @db.Text
  noResponseTimeoutSec Int         @default(30)
  noResponseClosing    String?     @db.Text
  announcementScript   String?     @db.Text
  endAfterAnnouncement Boolean     @default(true)
  // knowledge
  knowledgeText        String?     @db.MediumText
  // voice & language
  personality          String      @default("friendly") @db.VarChar(40)
  language             String      @default("hi-IN") @db.VarChar(10)
  voiceGender          String      @default("female") @db.VarChar(10)
  voiceId              String?     @db.VarChar(80)
  // AI models (advanced)
  llmProvider          String      @default("anthropic") @db.VarChar(40)
  llmModel             String      @default("claude-haiku-5-5") @db.VarChar(80)
  sttProvider          String      @default("deepgram") @db.VarChar(40)
  ttsProvider          String      @default("sarvam") @db.VarChar(40)
  // runtime
  memoryEnabled        Boolean     @default(true)
  recordingEnabled     Boolean     @default(true)
  maxConcurrentCalls   Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber?       @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  faqs         AgentFaq[]
  catalogItems AgentCatalogItem[]
  campaigns    Campaign[]
  calls        Call[]
  followUps    FollowUp[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model AgentFaq {
  id       String @id @default(cuid())
  agentId  String
  question String @db.Text
  answer   String @db.Text
  position Int    @default(0)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ---------- Services & Products ----------

enum CatalogType {
  SERVICE
  PRODUCT
}

model CatalogItem {
  id            String      @id @default(cuid())
  workspaceId   String
  type          CatalogType @default(SERVICE)
  name          String      @db.VarChar(120)
  description   String?     @db.Text
  priceText     String?     @db.VarChar(120) // what the caller hears, e.g. "From ₹4.5 lakh"
  mayQuotePrice Boolean     @default(true)
  whenToOffer   String?     @db.VarChar(255)
  nextAction    String?     @db.VarChar(255) // e.g. "Book demo", "Send sign-up link"
  trialDays     Int?
  signupUrl     String?     @db.VarChar(500)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    AgentCatalogItem[]
  leads     Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model AgentCatalogItem {
  agentId       String
  catalogItemId String

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@id([agentId, catalogItemId])
}

// ---------- Phone numbers ----------

model PhoneNumber {
  id          String    @id @default(cuid())
  workspaceId String? // null = in the platform pool, not yet assigned
  e164        String    @unique @db.VarChar(20)
  channels    Int       @default(1)
  sipTrunkId  String?   @db.VarChar(120)
  monthlyRent Decimal   @default(0) @db.Decimal(12, 2)
  renewsOn    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agents    Agent[]

  @@index([workspaceId])
}

// ---------- Leads (CRM) ----------

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  DEMO_PROPOSAL
  WON
  LOST
}

model Lead {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String?   @db.VarChar(160)
  phone            String    @db.VarChar(20) // normalised E.164
  city             String?   @db.VarChar(80)
  fields           Json? // extra spreadsheet columns, used as {placeholders}
  stage            LeadStage @default(NEW)
  interestedItemId String?
  dealValue        Decimal?  @db.Decimal(12, 2)
  notes            String?   @db.Text
  memory           String?   @db.Text // what the agent remembers about this caller
  assignedUserId   String?
  isDnd            Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interestedItem CatalogItem?   @relation(fields: [interestedItemId], references: [id], onDelete: SetNull)
  assignedUser   User?          @relation("LeadOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)
  campaignLeads  CampaignLead[]
  calls          Call[]
  followUps      FollowUp[]

  @@unique([workspaceId, phone])
  @@index([workspaceId, stage])
}

// ---------- Campaigns ----------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  agentId         String
  name            String         @db.VarChar(160)
  status          CampaignStatus @default(DRAFT)
  startAt         DateTime?
  callWindowFrom  String         @default("10:00") @db.VarChar(5)
  callWindowTo    String         @default("19:00") @db.VarChar(5)
  maxConcurrent   Int            @default(1)
  retryCount      Int            @default(2)
  retryGapMinutes Int            @default(180)
  skipDnd         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Cascade so deleting a workspace works; the app itself refuses to delete an agent that campaigns use.
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leads     CampaignLead[]
  calls     Call[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

enum CampaignLeadStatus {
  PENDING
  CALLING
  ANSWERED
  NO_ANSWER
  FAILED
  SKIPPED
}

model CampaignLead {
  id            String             @id @default(cuid())
  campaignId    String
  leadId        String
  status        CampaignLeadStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  lastError     String?            @db.VarChar(255)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId, status, nextAttemptAt])
}

// ---------- Calls ----------

enum CallDirection {
  OUTBOUND
  INBOUND
  BROWSER_TEST
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MESSAGE_PLAYED
  NO_DECISION
}

model Call {
  id           String        @id @default(cuid())
  workspaceId  String
  agentId      String?
  leadId       String?
  campaignId   String?
  direction    CallDirection
  status       CallStatus    @default(QUEUED)
  fromNumber   String?       @db.VarChar(20)
  toNumber     String?       @db.VarChar(20)
  roomName     String?       @db.VarChar(120)
  startedAt    DateTime      @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  durationSec  Int           @default(0) // talk time; 0 if never answered
  ratePerMin   Decimal?      @db.Decimal(8, 2)
  totalCharge  Decimal       @default(0) @db.Decimal(12, 2)
  recordingUrl String?       @db.VarChar(500)
  summary      String?       @db.Text
  outcome      CallOutcome?
  failReason   String?       @db.VarChar(255)
  usage        Json? // raw usage: llm tokens, tts chars, stt seconds

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign  Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messages  CallMessage[]
  followUps FollowUp[]

  @@index([workspaceId, startedAt])
  @@index([campaignId])
  @@index([leadId])
}

enum Speaker {
  AGENT
  CUSTOMER
}

model CallMessage {
  id     String   @id @default(cuid())
  callId String
  role   Speaker
  text   String   @db.Text
  at     DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, at])
}

// ---------- Follow-ups ----------

enum FollowUpKind {
  AI_CALLBACK
  STAFF_TASK
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

model FollowUp {
  id             String         @id @default(cuid())
  workspaceId    String
  leadId         String
  callId         String?
  agentId        String? // AI_CALLBACK: the agent who calls back
  kind           FollowUpKind
  title          String         @db.VarChar(255)
  dueAt          DateTime
  status         FollowUpStatus @default(OPEN)
  assignedUserId String?
  createdAt      DateTime       @default(now())
  doneAt         DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call         Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation("FollowUpOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueAt])
}

// ---------- Wallet ----------

enum TxType {
  TOPUP
  CALL_CHARGE
  PLAN
  ADJUSTMENT
}

model WalletTransaction {
  id           String   @id @default(cuid())
  workspaceId  String
  type         TxType
  amount       Decimal  @db.Decimal(12, 2) // + credit, − debit
  balanceAfter Decimal  @db.Decimal(12, 2)
  callId       String?  @unique // one charge per call
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
