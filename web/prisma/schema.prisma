// Voxura AI Calling Agent — data model.
// Every business record belongs to one Workspace (company). Queries must always filter by workspaceId.
// Uniqueness (agent names, catalog names, lead phones) is per workspace, never global.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Tenancy & users ----------

model Workspace {
  id             String    @id @default(cuid())
  name           String    @db.VarChar(120)
  gstNumber      String?   @db.VarChar(20)
  walletBalance  Decimal   @default(0) @db.Decimal(12, 2)
  lowBalanceAt   Decimal   @default(200) @db.Decimal(12, 2)
  callWindowFrom String    @default("10:00") @db.VarChar(5) // default calling hours (IST) for campaigns
  callWindowTo   String    @default("19:00") @db.VarChar(5)
  planId         String?
  planRenewsOn   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  plan         Plan?               @relation(fields: [planId], references: [id])
  users        User[]
  agents       Agent[]
  catalogItems CatalogItem[]
  phoneNumbers PhoneNumber[]
  leads        Lead[]
  campaigns    Campaign[]
  calls        Call[]
  followUps    FollowUp[]
  transactions WalletTransaction[]
  integrations    Integration[]
  apiKeys         ApiKey[]
  inboundEvents   InboundEvent[]
  assignmentRules AssignmentRule[]
  jobs            Job[]
  leadEvents      LeadEvent[]
}

enum UserRole {
  OWNER
  ADMIN
  STAFF
}

model User {
  id              String   @id @default(cuid())
  workspaceId     String
  name            String   @db.VarChar(120)
  email           String   @unique @db.VarChar(190)
  phone           String?  @db.VarChar(20)
  passwordHash    String   @db.VarChar(100)
  role            UserRole @default(OWNER)
  isPlatformAdmin Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  assignedLeads Lead[]     @relation("LeadOwner")
  followUps     FollowUp[] @relation("FollowUpOwner")
  leadEvents    LeadEvent[]

  @@index([workspaceId])
}

// ---------- Plans (platform-level, shared by all workspaces) ----------

model Plan {
  id           String   @id @default(cuid())
  name         String   @unique @db.VarChar(60)
  monthlyPrice Decimal  @db.Decimal(12, 2)
  agentLimit   Int
  channels     Int
  kbChars      Int
  faqLimit     Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  workspaces Workspace[]
}

// ---------- Agents ----------

enum AgentMode {
  ASSISTANT
  ANNOUNCEMENT
}

enum CallPurpose {
  OUTBOUND
  INBOUND
  BOTH
}

enum AgentStatus {
  ACTIVE
  PAUSED
}

model Agent {
  id                   String      @id @default(cuid())
  workspaceId          String
  name                 String      @db.VarChar(120)
  status               AgentStatus @default(ACTIVE)
  mode                 AgentMode   @default(ASSISTANT)
  purpose              CallPurpose @default(OUTBOUND)
  phoneNumberId        String?
  // what to say
  greeting             String?     @db.Text
  systemPrompt         String?     @db.Text
  fallbackResponse     String?     @db.Text
  noResponseTimeoutSec Int         @default(30)
  noResponseClosing    String?     @db.Text
  announcementScript   String?     @db.Text
  endAfterAnnouncement Boolean     @default(true)
  // knowledge
  knowledgeText        String?     @db.MediumText
  // voice & language
  personality          String      @default("friendly") @db.VarChar(40)
  language             String      @default("hi-IN") @db.VarChar(10)
  voiceGender          String      @default("female") @db.VarChar(10)
  voiceId              String?     @db.VarChar(80)
  // AI models (advanced)
  llmProvider          String      @default("anthropic") @db.VarChar(40)
  llmModel             String      @default("claude-haiku-5-5") @db.VarChar(80)
  sttProvider          String      @default("deepgram") @db.VarChar(40)
  ttsProvider          String      @default("sarvam") @db.VarChar(40)
  // runtime
  memoryEnabled        Boolean     @default(true)
  recordingEnabled     Boolean     @default(true)
  maxConcurrentCalls   Int         @default(1)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  workspace    Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  phoneNumber  PhoneNumber?       @relation(fields: [phoneNumberId], references: [id], onDelete: SetNull)
  faqs         AgentFaq[]
  catalogItems AgentCatalogItem[]
  campaigns    Campaign[]
  calls        Call[]
  followUps    FollowUp[]
  leads        Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model AgentFaq {
  id       String @id @default(cuid())
  agentId  String
  question String @db.Text
  answer   String @db.Text
  position Int    @default(0)

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

// ---------- Services & Products ----------

enum CatalogType {
  SERVICE
  PRODUCT
}

model CatalogItem {
  id            String      @id @default(cuid())
  workspaceId   String
  type          CatalogType @default(SERVICE)
  name          String      @db.VarChar(120)
  description   String?     @db.Text
  priceText     String?     @db.VarChar(120) // what the caller hears, e.g. "From ₹4.5 lakh"
  mayQuotePrice Boolean     @default(true)
  whenToOffer   String?     @db.VarChar(255)
  nextAction    String?     @db.VarChar(255) // e.g. "Book demo", "Send sign-up link"
  trialDays     Int?
  signupUrl     String?     @db.VarChar(500)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agents    AgentCatalogItem[]
  leads     Lead[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model AgentCatalogItem {
  agentId       String
  catalogItemId String

  agent       Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem @relation(fields: [catalogItemId], references: [id], onDelete: Cascade)

  @@id([agentId, catalogItemId])
}

// ---------- Phone numbers ----------

model PhoneNumber {
  id          String    @id @default(cuid())
  workspaceId String? // null = in the platform pool, not yet assigned
  e164        String    @unique @db.VarChar(20)
  channels    Int       @default(1)
  sipTrunkId  String?   @db.VarChar(120)
  monthlyRent Decimal   @default(0) @db.Decimal(12, 2)
  renewsOn    DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  agents    Agent[]

  @@index([workspaceId])
}

// ---------- Leads (CRM) ----------

enum LeadStage {
  NEW
  CONTACTED
  INTERESTED
  DEMO_PROPOSAL
  WON
  LOST
}

model Lead {
  id               String    @id @default(cuid())
  workspaceId      String
  name             String?   @db.VarChar(160)
  phone            String    @db.VarChar(20) // normalised E.164
  city             String?   @db.VarChar(80)
  fields           Json? // extra spreadsheet columns, used as {placeholders}
  stage            LeadStage @default(NEW)
  interestedItemId String?
  dealValue        Decimal?  @db.Decimal(12, 2)
  notes            String?   @db.Text
  memory           String?   @db.Text // what the agent remembers about this caller
  assignedUserId   String?
  isDnd            Boolean   @default(false)
  // Added for the Lead Source Integration Hub. All optional, so older leads are unchanged.
  email            String?      @db.VarChar(190) // stored lower-case
  company          String?      @db.VarChar(160)
  requirements     String?      @db.Text
  budget           String?      @db.VarChar(80)
  language         String?      @db.VarChar(10) // e.g. hi-IN
  category         String?      @db.VarChar(80) // business category
  agentId          String? // AI agent that will handle this lead
  aiStatus         LeadAiStatus @default(NOT_QUEUED)
  aiStatusReason   String?      @db.VarChar(255)
  aiQueuedAt       DateTime?
  consentAt        DateTime?
  consentSource    String?      @db.VarChar(120)
  consentEvidence  String?      @db.Text
  consentChannels  Json? // ["CALL","WHATSAPP","SMS","EMAIL"]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  interestedItem CatalogItem?     @relation(fields: [interestedItemId], references: [id], onDelete: SetNull)
  assignedUser   User?            @relation("LeadOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)
  agent          Agent?           @relation(fields: [agentId], references: [id], onDelete: SetNull)
  campaignLeads  CampaignLead[]
  calls          Call[]
  followUps      FollowUp[]
  sources        LeadSourceLink[]
  events         LeadEvent[]
  inboundEvents  InboundEvent[]

  @@unique([workspaceId, phone])
  @@index([workspaceId, stage])
  @@index([workspaceId, email])
  @@index([workspaceId, aiStatus])
}

// Whether future AI campaigns may pick this lead up. Nothing is called automatically until the voice engine and compliance checks are ready.
enum LeadAiStatus {
  NOT_QUEUED
  QUEUED
  INELIGIBLE
}

// ---------- Campaigns ----------

enum CampaignStatus {
  DRAFT
  SCHEDULED
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

model Campaign {
  id              String         @id @default(cuid())
  workspaceId     String
  agentId         String
  name            String         @db.VarChar(160)
  status          CampaignStatus @default(DRAFT)
  startAt         DateTime?
  callWindowFrom  String         @default("10:00") @db.VarChar(5)
  callWindowTo    String         @default("19:00") @db.VarChar(5)
  maxConcurrent   Int            @default(1)
  retryCount      Int            @default(2)
  retryGapMinutes Int            @default(180)
  skipDnd         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  completedAt     DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  // Cascade so deleting a workspace works; the app itself refuses to delete an agent that campaigns use.
  agent     Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  leads     CampaignLead[]
  calls     Call[]

  @@unique([workspaceId, name])
  @@index([workspaceId, status])
}

enum CampaignLeadStatus {
  PENDING
  CALLING
  ANSWERED
  NO_ANSWER
  FAILED
  SKIPPED
}

model CampaignLead {
  id            String             @id @default(cuid())
  campaignId    String
  leadId        String
  status        CampaignLeadStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime?
  lastError     String?            @db.VarChar(255)

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@index([campaignId, status, nextAttemptAt])
}

// ---------- Calls ----------

enum CallDirection {
  OUTBOUND
  INBOUND
  BROWSER_TEST
}

enum CallStatus {
  QUEUED
  RINGING
  IN_PROGRESS
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  MESSAGE_PLAYED
  NO_DECISION
}

model Call {
  id           String        @id @default(cuid())
  workspaceId  String
  agentId      String?
  leadId       String?
  campaignId   String?
  direction    CallDirection
  status       CallStatus    @default(QUEUED)
  fromNumber   String?       @db.VarChar(20)
  toNumber     String?       @db.VarChar(20)
  roomName     String?       @db.VarChar(120)
  startedAt    DateTime      @default(now())
  answeredAt   DateTime?
  endedAt      DateTime?
  durationSec  Int           @default(0) // talk time; 0 if never answered
  ratePerMin   Decimal?      @db.Decimal(8, 2)
  totalCharge  Decimal       @default(0) @db.Decimal(12, 2)
  recordingUrl String?       @db.VarChar(500)
  summary      String?       @db.Text
  outcome      CallOutcome?
  failReason   String?       @db.VarChar(255)
  usage        Json? // raw usage: llm tokens, tts chars, stt seconds

  workspace Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  agent     Agent?        @relation(fields: [agentId], references: [id], onDelete: SetNull)
  lead      Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  campaign  Campaign?     @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  messages  CallMessage[]
  followUps FollowUp[]

  @@index([workspaceId, startedAt])
  @@index([campaignId])
  @@index([leadId])
}

enum Speaker {
  AGENT
  CUSTOMER
}

model CallMessage {
  id     String   @id @default(cuid())
  callId String
  role   Speaker
  text   String   @db.Text
  at     DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId, at])
}

// ---------- Follow-ups ----------

enum FollowUpKind {
  AI_CALLBACK
  STAFF_TASK
}

enum FollowUpStatus {
  OPEN
  DONE
  CANCELLED
}

model FollowUp {
  id             String         @id @default(cuid())
  workspaceId    String
  leadId         String
  callId         String?
  agentId        String? // AI_CALLBACK: the agent who calls back
  kind           FollowUpKind
  title          String         @db.VarChar(255)
  dueAt          DateTime
  status         FollowUpStatus @default(OPEN)
  assignedUserId String?
  createdAt      DateTime       @default(now())
  doneAt         DateTime?

  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  call         Call?     @relation(fields: [callId], references: [id], onDelete: SetNull)
  agent        Agent?    @relation(fields: [agentId], references: [id], onDelete: SetNull)
  assignedUser User?     @relation("FollowUpOwner", fields: [assignedUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, dueAt])
}

// ---------- Wallet ----------

enum TxType {
  TOPUP
  CALL_CHARGE
  PLAN
  ADJUSTMENT
}

model WalletTransaction {
  id           String   @id @default(cuid())
  workspaceId  String
  type         TxType
  amount       Decimal  @db.Decimal(12, 2) // + credit, − debit
  balanceAfter Decimal  @db.Decimal(12, 2)
  callId       String?  @unique // one charge per call
  note         String?  @db.VarChar(255)
  createdAt    DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

// ---------- Lead Source Integration Hub ----------
// Every row belongs to one workspace. Secrets are stored encrypted (IntegrationSecret) or hashed (ApiKey), never in plain text.

enum IntegrationType {
  CSV_IMPORT
  API
  WEBHOOK
  WEBSITE_FORM
  ZAPIER
  MAKE
  GOOGLE_SHEETS
  WORDPRESS
  GOOGLE_ADS
  META
  INDIAMART
  JUSTDIAL
  ACRES99
}

enum IntegrationStatus {
  ACTIVE
  PAUSED
  ERROR
  DISCONNECTED
}

model Integration {
  id            String            @id @default(cuid())
  workspaceId   String
  type          IntegrationType
  name          String            @db.VarChar(120)
  status        IntegrationStatus @default(ACTIVE)
  endpointKey   String?           @unique @db.VarChar(40) // public id used in the webhook URL
  config        Json? // allowed domains, field mapping, etc.
  lastEventAt   DateTime?
  lastSuccessAt DateTime?
  lastErrorAt   DateTime?
  lastError     String?           @db.VarChar(500)
  totalReceived Int               @default(0)
  totalCreated  Int               @default(0)
  totalMerged   Int               @default(0)
  totalFailed   Int               @default(0)
  createdById   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  workspace Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  secrets   IntegrationSecret[]
  apiKeys   ApiKey[]
  events    InboundEvent[]
  sources   LeadSourceLink[]

  @@unique([workspaceId, name])
  @@index([workspaceId, type])
}

model IntegrationSecret {
  id            String    @id @default(cuid())
  integrationId String
  kind          String    @db.VarChar(40) // e.g. webhook_secret, access_token
  ciphertext    String    @db.Text // AES-256-GCM: iv.tag.data (base64)
  hint          String?   @db.VarChar(12) // last 4 characters, for display only
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@unique([integrationId, kind])
}

model ApiKey {
  id            String    @id @default(cuid())
  workspaceId   String
  integrationId String
  name          String    @db.VarChar(80)
  prefix        String    @db.VarChar(20) // shown to the user, e.g. vx_live_ab12
  hash          String    @unique @db.VarChar(64) // sha256 of the full key
  lastUsedAt    DateTime?
  revokedAt     DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

enum InboundStatus {
  RECEIVED
  PROCESSING
  CREATED
  MERGED
  REJECTED
  FAILED
}

// Every incoming lead is stored here first (raw payload), then processed by a job. dedupeKey stops the same event twice.
model InboundEvent {
  id            String        @id @default(cuid())
  workspaceId   String
  integrationId String
  dedupeKey     String        @db.VarChar(191)
  externalId    String?       @db.VarChar(191)
  payload       Json
  status        InboundStatus @default(RECEIVED)
  result        String?       @db.VarChar(500)
  trace         Json? // step-by-step processing log
  leadId        String?
  ip            String?       @db.VarChar(64)
  receivedAt    DateTime      @default(now())
  processedAt   DateTime?

  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  lead        Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([integrationId, dedupeKey])
  @@index([workspaceId, receivedAt])
  @@index([integrationId, status])
}

// Every source a lead came from (a lead can arrive from several), with campaign / ad / form details.
model LeadSourceLink {
  id             String   @id @default(cuid())
  workspaceId    String
  leadId         String
  integrationId  String
  inboundEventId String?  @unique
  externalLeadId String?  @db.VarChar(191)
  formName       String?  @db.VarChar(160)
  campaignName   String?  @db.VarChar(160)
  adName         String?  @db.VarChar(160)
  receivedAt     DateTime @default(now())

  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([workspaceId, leadId])
  @@index([integrationId])
}

// Everything that happened to a lead (created, source added, field changed, task created, queued for AI ...).
// Append-only, so the future AI orchestration engine and auditors can read the whole journey.
model LeadEvent {
  id          String   @id @default(cuid())
  workspaceId String
  leadId      String
  type        String   @db.VarChar(40)
  actorType   String   @db.VarChar(20) // USER | SYSTEM | INTEGRATION | AI
  actorUserId String?
  data        Json?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead      Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  actorUser User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
  @@index([workspaceId, createdAt])
}

// Ordered rules: the first active rule whose conditions all match decides the agent, salesperson and next step.
model AssignmentRule {
  id               String   @id @default(cuid())
  workspaceId      String
  name             String   @db.VarChar(120)
  position         Int      @default(0)
  isActive         Boolean  @default(true)
  conditions       Json // { integrationIds, campaignContains, cities, languages, categories, field: { key, equals } }
  agentId          String?
  salespersonMode  String   @default("NONE") @db.VarChar(12) // NONE | FIXED | ROUND_ROBIN
  salespersonIds   Json?
  roundRobinCursor Int      @default(0)
  createTask       Boolean  @default(true)
  queueForAi       Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, position])
}

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

// Background work with safe retries. Claimed atomically (lockedUntil), so two workers never run the same job.
model Job {
  id          String    @id @default(cuid())
  workspaceId String
  type        String    @db.VarChar(40)
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAt       DateTime  @default(now())
  lockedUntil DateTime?
  lastError   String?   @db.VarChar(1000)
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([workspaceId, status])
}
